{
  "name": "terax-v2",
  "version": "1.0.0",
  "description": "CRC Fullstack App - CRUD for HR/Company Management",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "dev": "nodemon server/index.js",
    "qa:requires": "node scripts/qa/require-graph.js",
    "qa:routes": "node scripts/qa/route-inventory.js --check",
    "qa:routes:baseline": "node scripts/qa/route-inventory.js --write",
    "qa:smoke": "node scripts/qa/smoke.js",
    "qa": "npm run qa:requires && npm run qa:routes",
    "qa:clone": "node scripts/qa/clone-test.js . qa/clone.current.json",
    "qa:clone:diff": "node scripts/qa/clone-test.js . qa/clone.current.json && node scripts/qa/clone-fingerprint.js --diff qa/clone.baseline.json qa/clone.current.json",
    "qa:all": "npm run qa && npm run qa:clone:diff"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.18.2",
    "express-rate-limit": "^8.5.2",
    "google-auth-library": "^10.6.2",
    "hashids": "^2.3.0",
    "jsonwebtoken": "^9.0.3",
    "node-cron": "^4.2.1",
    "pg": "^8.11.3",
    "ssh2": "^1.17.0",
    "uuid": "^9.0.0",
    "web-push": "^3.6.7",
    "xlsx": "^0.18.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "nodemon": "^3.0.3",
    "pdfkit": "^0.19.1",
    "puppeteer": "^25.3.0"
  }
}


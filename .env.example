# =========================================================================
# CRC APP - ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to '.env' and fill in your custom credentials.
# =========================================================================

# Database URL used when running locally on the host machine.
# (Note: Inside Docker Compose, this is automatically overridden to use the internal 'db' container).
DATABASE_URL=postgres://crc_user:crc2026@localhost:9999/crc_db

# Port the Node.js application will run on
PORT=5221

# Secret key used for signing JWT login tokens (Change this to a random string in production!)
JWT_SECRET=crc_super_secret_key_123_change_in_prod

# -------------------------------------------------------------------------
# CLOUDFLARE TUNNEL CONFIGURATION (Domain Setup)
# -------------------------------------------------------------------------
# Paste the Tunnel Token from your Cloudflare Zero Trust Dashboard here.
# This maps your application to your custom domain securely without port forwarding.
TUNNEL_TOKEN=your_cloudflare_tunnel_token_here

# --- Security (see server/middleware/security.js) ---
# TRUST_PROXY=1            # number of reverse-proxy hops in front of the app
# CORS_ORIGINS=https://app.example.com,*.example.com   # empty = allow all
# BODY_LIMIT=25mb          # JSON body limit for authenticated routes
# UPLOAD_MAX_BYTES=209715200
# JWT_EXPIRES_IN=7d
# CMS_LOOKUP_DB_PASSWORD=  # required for direct CMS lookup DB access
